#!/bin/bash
#
# gw-egress — inspect and change where each ingress channel's traffic leaves.
#
#   gw-egress                          show every egress path and who uses it
#   gw-egress set <channel> <egress>   repoint one channel
#   gw-egress set all <egress>         repoint every channel
#   gw-egress test                     prove where each channel actually exits
#   gw-egress add <name> [options]     declare a new tunnel exit
#   gw-egress remove <name>            remove one nothing points at
#
# Options for add:
#   --endpoint <host:port>   the exit server
#   --pubkey <key>           its public key
#   --privkey <key>          this gateway's private key on that peer
#                            (omitted: one is generated and its public key printed)
#   --psk <key>              preshared key, if the exit uses one
#   --address <ip/cidr>      this gateway's address inside the tunnel
#   --proto <wg|awg>         default wg
#   --port <n>               local listen port; default: first free from 51900
#   --conf-file <path>       a provider-supplied .conf instead of the above
#
# Changes are live: clients stay connected to their ingress interface and only
# the path underneath them changes. The choice is written back to the config,
# so it survives a reboot.
#
set -euo pipefail

CONF_FILE="${GATEWAY_CONF:-/etc/gateway/gateway.conf}"
ROUTES="/etc/gateway/gw-routes.sh"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
die() { echo "${RED}ERROR:${NC} $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "must run as root"
[[ -r "$CONF_FILE" ]] || die "config not readable: $CONF_FILE"
# shellcheck disable=SC1090
source "$CONF_FILE"

LIB="/etc/gateway/gw-lib.sh"
[[ -r "$LIB" ]] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/gw-lib.sh"
[[ -r "$LIB" ]] || die "gw-lib.sh not found (expected /etc/gateway/gw-lib.sh) — re-run install.sh"
# shellcheck source=files/gw-lib.sh
# shellcheck disable=SC1090
source "$LIB"
: "${INGRESS_CHANNELS:=}"; : "${EGRESS_PATHS:=direct}"; : "${POLICY_RULES:=}"
SUBS=""

DEF_IF="$(ip route show default | awk '/default/ {print $5; exit}')"

cfg() { local v="$1"; echo "${!v-}"; }
eg_type() { local t; t="$(cfg "EGRESS_${1}_TYPE")"; [[ -n "$t" ]] || { [[ "$1" == "direct" ]] && t="direct" || t=""; }; echo "$t"; }
eg_iface(){ [[ "$(eg_type "$1")" == "direct" ]] && echo "$DEF_IF" || echo "out-$1"; }
eg_table(){ echo "gw_$1"; }
ch_net()  { cfg "INGRESS_${1}_NET"; }
ch_egress(){ local e; e="$(cfg "INGRESS_${1}_EGRESS")"; [[ -n "$e" ]] || e="$(echo "$EGRESS_PATHS" | awk '{print $1}')"; echo "$e"; }
ch_iface(){ echo "in-$1"; }
egress_exists() { [[ " ${EGRESS_PATHS} " == *" ${1} "* ]]; }
channel_exists(){ [[ " ${INGRESS_CHANNELS} " == *" ${1} "* ]]; }

# The last handshake on a tunnel egress, in seconds ago. Empty if never.
eg_age() {
    local dev="$1" t hs
    for t in wg awg; do
        command -v "$t" >/dev/null || continue
        hs="$($t show "$dev" latest-handshakes 2>/dev/null | awk '{print $2}' | sort -rn | head -1)" || true
        [[ -n "${hs:-}" && "$hs" != "0" ]] && { echo $(( $(date +%s) - hs )); return 0; }
    done
    echo ""
}

show_status() {
    local e dev state age users c eff
    SUBS="$(health_subs)"
    printf '%s%-10s %-8s %-12s %-22s %s%s\n' "$BOLD" EGRESS TYPE INTERFACE STATE "CHANNELS" "$NC"
    for e in $EGRESS_PATHS; do
        dev="$(eg_iface "$e")"
        if [[ "$(eg_type "$e")" == "direct" ]]; then
            state="${GREEN}uplink${NC}"
        elif ip link show "$dev" &>/dev/null; then
            age="$(eg_age "$dev")"
            if   [[ -z "$age" ]];        then state="${RED}no handshake${NC}"
            elif [[ "$age" -lt 300 ]];   then state="${GREEN}up (${age}s ago)${NC}"
            else                              state="${RED}stale (${age}s ago)${NC}"; fi
        else
            state="${RED}down${NC}"
        fi
        users=""
        for c in $INGRESS_CHANNELS; do
            [[ "$(ch_egress "$c")" == "$e" ]] && users="${users}${users:+, }${c}"
        done
        printf '%-10s %-8s %-12s %-22b %s\n' "$e" "$(eg_type "$e")" "$dev" "$state" "${users:--}"
        eff="$(eg_effective "$e" "$SUBS")"
        [[ "$eff" == "$e" ]] || \
            printf '           %sits traffic is being carried by %s while it is down (gw-health back %s)%s\n' \
                "$YELLOW" "$eff" "$e" "$NC"
    done
    echo
    echo "${CYAN}routing tables${NC}"
    for e in $EGRESS_PATHS; do
        printf '  %-10s %s\n' "$e" "$(ip route show table "$(eg_table "$e")" 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g')"
    done
}

# The decisive check: ask the kernel where a packet from a real client address
# would actually go. This is what catches flushed policy rules, which otherwise
# leave clients connected while silently egressing from the wrong place.
show_test() {
    local c net probe route want dev
    SUBS="$(health_subs)"
    echo "${CYAN}actual egress per channel${NC}"
    for c in $INGRESS_CHANNELS; do
        net="$(ch_net "$c")"
        ip link show "$(ch_iface "$c")" &>/dev/null || { printf '  %-12s %s\n' "$c" "interface down"; continue; }
        probe="${net%.0/24}.2"
        route="$(ip route get 1.1.1.1 from "$probe" iif "$(ch_iface "$c")" 2>/dev/null | head -1)" || route=""
        # Where it should be leaving, given any failover in force. Comparing
        # against the configured path instead would report a working
        # substitution as a leak.
        want="$(eg_iface "$(eg_effective "$(ch_egress "$c")" "$SUBS")")"
        dev="$(awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' <<< "$route")"
        if [[ -z "$route" ]]; then
            printf '  %-12s %sno route%s (expected %s)\n' "$c" "$RED" "$NC" "$want"
        elif [[ "$dev" == "$want" ]]; then
            printf '  %-12s %s%s%s via %s\n' "$c" "$GREEN" "$dev" "$NC" "$(ch_egress "$c")"
        else
            printf '  %-12s %sLEAKING: %s, expected %s%s\n' "$c" "$RED" "${dev:-?}" "$want" "$NC"
        fi
    done
}

# conf_set comes from gw-lib.sh, shared with gw-config.

# The first local port from 51900 that no egress already claims. Two WireGuard
# interfaces cannot share one, and a collision fails at bring-up rather than
# at validation, so pick it here instead of making the operator track it.
next_free_port() {
    local p=51900 e used
    while :; do
        used=no
        for e in $EGRESS_PATHS; do [[ "$(cfg "EGRESS_${e}_PORT")" == "$p" ]] && used=yes; done
        grep -qE "^INGRESS_[a-z0-9_]+_PORT=\"?${p}\"?$" "$CONF_FILE" && used=yes
        [[ "$used" == no ]] && { echo "$p"; return 0; }
        p=$((p + 1))
    done
}

cmd_add() {
    local name="${1:-}"; shift || true
    [[ -n "$name" ]] || die "usage: gw-egress add <name> [options]"
    [[ "$name" =~ ^[a-z][a-z0-9_]*$ ]] || die "egress names are lowercase letters, digits and _"
    egress_exists "$name" && die "'${name}' is already an egress path"

    local proto=wg endpoint="" pubkey="" privkey="" psk="" address="" port="" conffile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --endpoint)  endpoint="${2:-}"; shift 2 ;;
            --pubkey)    pubkey="${2:-}";   shift 2 ;;
            --privkey)   privkey="${2:-}";  shift 2 ;;
            --psk)       psk="${2:-}";      shift 2 ;;
            --address)   address="${2:-}";  shift 2 ;;
            --proto)     proto="${2:-}";    shift 2 ;;
            --port)      port="${2:-}";     shift 2 ;;
            --conf-file) conffile="${2:-}"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [[ "$proto" == "wg" || "$proto" == "awg" ]] || die "--proto must be wg or awg"
    if [[ -n "$port" ]]; then
        # Unchecked, a typo here is written to the config, passes validation as
        # a string, and only surfaces at bring-up in a different tool.
        [[ "$port" =~ ^[0-9]+$ && "$port" -ge 1024 && "$port" -le 65535 ]] \
            || die "--port must be a number between 1024 and 65535, got '${port}'"
    else
        port="$(next_free_port)"
    fi

    if [[ -n "$conffile" ]]; then
        [[ -r "$conffile" ]] || die "cannot read ${conffile}"
        conf_set "EGRESS_${name}_TYPE" "tunnel"
        conf_set "EGRESS_${name}_CONF_FILE" "$conffile"
        conf_set "EGRESS_${name}_PORT" "$port"
    else
        [[ -n "$endpoint" ]] || die "--endpoint <host:port> is required (or --conf-file)"
        [[ -n "$pubkey" ]]   || die "--pubkey is required (or --conf-file)"
        [[ -n "$address" ]]  || die "--address <ip/cidr> is required (or --conf-file)"
        # Generating the key here means the operator never has to invent one,
        # and the public half is printed so it can be pasted into the exit.
        local generated=no
        if [[ -z "$privkey" ]]; then
            privkey="$( [[ "$proto" == awg ]] && awg genkey || wg genkey )"
            generated=yes
        fi
        conf_set "EGRESS_${name}_TYPE" "tunnel"
        conf_set "EGRESS_${name}_PROTO" "$proto"
        conf_set "EGRESS_${name}_ENDPOINT" "$endpoint"
        conf_set "EGRESS_${name}_PUBKEY" "$pubkey"
        conf_set "EGRESS_${name}_PRIVKEY" "$privkey"
        conf_set "EGRESS_${name}_PSK" "$psk"
        conf_set "EGRESS_${name}_ADDRESS" "$address"
        conf_set "EGRESS_${name}_PORT" "$port"
        if [[ "$generated" == yes ]]; then
            echo "${YELLOW}A key pair was generated for this gateway. Add this peer on the exit server:${NC}"
            echo
            echo "  [Peer]"
            echo "  PublicKey = $(printf '%s' "$privkey" | { [[ "$proto" == awg ]] && awg pubkey || wg pubkey; })"
            echo "  AllowedIPs = ${address%%/*}/32"
            echo
        fi
    fi
    conf_set EGRESS_PATHS "${EGRESS_PATHS} ${name}"
    echo "${GREEN}declared egress '${name}' on local port ${port}${NC}"
    echo "  ${BOLD}It is not live until you apply it:${NC} gw-config apply"
    echo "  Then point something at it:  gw-egress set <channel> ${name}"
}

cmd_remove() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "usage: gw-egress remove <name>"
    egress_exists "$name" || die "'${name}' is not an egress path"
    [[ "$name" == "direct" ]] && die "'direct' is this box's own uplink and cannot be removed"

    # Refuse while anything still routes to it: removing it would leave those
    # channels and rules pointing at a path that does not exist.
    local c users=""
    for c in $INGRESS_CHANNELS; do
        [[ "$(ch_egress "$c")" == "$name" ]] && users="${users} ${c}"
    done
    local r
    for r in ${POLICY_RULES:-}; do
        [[ "$(cfg "POLICY_${r}_EGRESS")" == "$name" ]] && users="${users} policy:${r}"
    done
    [[ -z "$users" ]] || die "still in use by:${users} — repoint those first (gw-egress set <channel> <other>)"

    local dev conf unit down
    dev="$(eg_iface "$name")"
    if [[ -f "/etc/amnezia/amneziawg/${dev}.conf" ]]; then
        conf="/etc/amnezia/amneziawg/${dev}.conf"; unit="awg-quick@${dev}"; down="awg-quick"
    else
        conf="/etc/wireguard/${dev}.conf"; unit="wg-quick@${dev}"; down="wg-quick"
    fi
    # The installer enabled this unit. Left enabled, the tunnel comes back on the
    # next boot with no routing, no NAT and nothing here able to see it.
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    if ip link show "$dev" &>/dev/null; then $down down "$dev" || true; fi
    # And the rendered config holds this gateway's private key for a peer it is
    # no longer supposed to talk to.
    rm -f "$conf"
    sed -i "/^EGRESS_${name}_/d" "$CONF_FILE"
    local rest=""
    for e in $EGRESS_PATHS; do [[ "$e" == "$name" ]] || rest="${rest} ${e}"; done
    conf_set EGRESS_PATHS "${rest# }"
    echo "${GREEN}removed egress '${name}'${NC}"
    echo "  ${BOLD}Apply to clean up its routing table and rules:${NC} gw-config apply"
}

cmd="${1:-status}"
case "$cmd" in
    status|"") show_status; echo; show_test; exit 0 ;;
    test)      show_test; exit 0 ;;
    add)       [[ $EUID -eq 0 ]] || die "must run as root"; shift; cmd_add "$@"; exit 0 ;;
    remove)    [[ $EUID -eq 0 ]] || die "must run as root"; shift; cmd_remove "$@"; exit 0 ;;
    set)       ;;
    -h|--help) sed -n '2,30p' "$0" | sed 's/^#//;s/^ //'; exit 0 ;;
    *) die "usage: gw-egress [status|test|add|remove|set <channel|all> <egress>]" ;;
esac

target_ch="${2:-}"; target_eg="${3:-}"
[[ -n "$target_ch" && -n "$target_eg" ]] || die "usage: gw-egress set <channel|all> <egress>"
egress_exists "$target_eg" || die "'${target_eg}' is not in EGRESS_PATHS (${EGRESS_PATHS})"

channels=""
if [[ "$target_ch" == "all" ]]; then
    channels="$INGRESS_CHANNELS"
else
    channel_exists "$target_ch" || die "'${target_ch}' is not in INGRESS_CHANNELS (${INGRESS_CHANNELS})"
    channels="$target_ch"
fi

# Refuse to point a channel at an egress that cannot carry it — the result
# would be a fail-closed blackhole that looks like a broken VPN.
if [[ "$(eg_type "$target_eg")" != "direct" ]]; then
    dev="$(eg_iface "$target_eg")"
    if ! ip link show "$dev" &>/dev/null; then
        echo "${YELLOW}bringing up ${dev}...${NC}"
        if [[ -f "/etc/amnezia/amneziawg/${dev}.conf" ]]; then awg-quick up "$dev"; else wg-quick up "$dev"; fi
    fi
    ip link show "$dev" &>/dev/null || die "${dev} will not come up; refusing to switch"
fi

for c in $channels; do
    if grep -q "^INGRESS_${c}_EGRESS=" "$CONF_FILE"; then
        sed -i "s|^INGRESS_${c}_EGRESS=.*|INGRESS_${c}_EGRESS=\"${target_eg}\"|" "$CONF_FILE"
    else
        echo "INGRESS_${c}_EGRESS=\"${target_eg}\"" >> "$CONF_FILE"
    fi
done

# gw-routes.sh re-reads the config and is the single place that knows how to
# stage routes, NAT and marks consistently.
for c in $channels; do
    ip link show "$(ch_iface "$c")" &>/dev/null || continue
    "$ROUTES" up "$c" >/dev/null
done

echo "${GREEN}${channels// /, } -> ${target_eg}${NC}"
echo
# Re-read so the summary reflects what was just written.
# shellcheck disable=SC1090
source "$CONF_FILE"
show_status; echo; show_test
